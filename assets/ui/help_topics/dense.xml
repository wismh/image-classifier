<Stack class="h-topic-body" direction="vertical">
    <Label class="h-kicker" text="{tr help.dense.kicker}"/>
    <Label class="h-title" text="{tr help.dense.title}"/>
    <Label class="h-head" text="{tr help.h.idea}"/>
    <Label class="h-p" text="{tr help.dense.p1}"/>
    <Label class="h-p" text="{tr help.dense.p2}"/>
    <Label class="h-head" text="{tr help.h.formulas}"/>
    <Stack class="h-formula" direction="vertical">
        <Math class="h-math" display="true" formula="h_j = \max\left(0, \; \sum_i w^{(1)}_{ji} \, a_i + b^{(1)}_j \right)"/>
        <Math class="h-math" display="true" formula="s_k = \sum_j w^{(2)}_{kj} \, h_j + b^{(2)}_k"/>
    </Stack>
    <Label class="h-head" text="{tr help.h.legend}"/>
    <Stack class="h-legend" direction="vertical">
        <Stack class="h-legend-row" direction="horizontal">
            <Stack class="h-sym" direction="vertical">
                <Math class="h-sym-math" formula="a_i"/>
            </Stack>
            <Label class="h-legend-text" text="{tr help.dense.legend6_0}"/>
        </Stack>
        <Stack class="h-legend-row" direction="horizontal">
            <Stack class="h-sym" direction="vertical">
                <Math class="h-sym-math" formula="h_j"/>
            </Stack>
            <Label class="h-legend-text" text="{tr help.dense.legend6_1}"/>
        </Stack>
        <Stack class="h-legend-row" direction="horizontal">
            <Stack class="h-sym" direction="vertical">
                <Math class="h-sym-math" formula="s_k"/>
            </Stack>
            <Label class="h-legend-text" text="{tr help.dense.legend6_2}"/>
        </Stack>
    </Stack>
    <Label class="h-head" text="{tr help.h.faq}"/>
    <Stack class="h-faq" direction="vertical">
        <Stack class="h-qa" direction="vertical">
            <Label class="h-q" text="{tr help.dense.q8_0}"/>
            <Label class="h-a" text="{tr help.dense.a8_0}"/>
        </Stack>
    </Stack>
    <Button class="h-try" content="{tr help.dense.try}" command="{binding tryIt}"/>
</Stack>
