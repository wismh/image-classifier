<Stack class="h-topic-body" direction="vertical">
    <Label class="h-kicker" text="{tr help.gradient.kicker}"/>
    <Label class="h-title" text="{tr help.gradient.title}"/>
    <Label class="h-head" text="{tr help.h.idea}"/>
    <Label class="h-p" text="{tr help.gradient.p1}"/>
    <Label class="h-p" text="{tr help.gradient.p2}"/>
    <Label class="h-head" text="{tr help.h.formulas}"/>
    <Stack class="h-formula" direction="vertical">
        <Math class="h-math" display="true" formula="w \leftarrow w - \eta \, \frac{\partial L}{\partial w}"/>
    </Stack>
    <Label class="h-head" text="{tr help.h.legend}"/>
    <Stack class="h-legend" direction="vertical">
        <Stack class="h-legend-row" direction="horizontal">
            <Stack class="h-sym" direction="vertical">
                <Math class="h-sym-math" formula="w"/>
            </Stack>
            <Label class="h-legend-text" text="{tr help.gradient.legend6_0}"/>
        </Stack>
        <Stack class="h-legend-row" direction="horizontal">
            <Stack class="h-sym" direction="vertical">
                <Math class="h-sym-math" formula="\eta"/>
            </Stack>
            <Label class="h-legend-text" text="{tr help.gradient.legend6_1}"/>
        </Stack>
        <Stack class="h-legend-row" direction="horizontal">
            <Stack class="h-sym" direction="vertical">
                <Math class="h-sym-math" formula="\partial L / \partial w"/>
            </Stack>
            <Label class="h-legend-text" text="{tr help.gradient.legend6_2}"/>
        </Stack>
    </Stack>
    <Label class="h-head" text="{tr help.h.faq}"/>
    <Stack class="h-faq" direction="vertical">
        <Stack class="h-qa" direction="vertical">
            <Label class="h-q" text="{tr help.gradient.q8_0}"/>
            <Label class="h-a" text="{tr help.gradient.a8_0}"/>
        </Stack>
    </Stack>
    <Button class="h-try" content="{tr help.gradient.try}" command="{binding tryIt}"/>
</Stack>
