<Stack class="h-topic-body" direction="vertical">
    <Label class="h-kicker" text="{tr help.metrics.kicker}"/>
    <Label class="h-title" text="{tr help.metrics.title}"/>
    <Label class="h-head" text="{tr help.h.idea}"/>
    <Label class="h-p" text="{tr help.metrics.p1}"/>
    <Label class="h-p" text="{tr help.metrics.p2}"/>
    <Label class="h-head" text="{tr help.h.formulas}"/>
    <Stack class="h-formula" direction="vertical">
        <Math class="h-math" display="true" formula="\text{balanced} = \tfrac{1}{2}\left(\text{accuracy}_{1} + \text{accuracy}_{2}\right)"/>
    </Stack>
    <Label class="h-head" text="{tr help.h.faq}"/>
    <Stack class="h-faq" direction="vertical">
        <Stack class="h-qa" direction="vertical">
            <Label class="h-q" text="{tr help.metrics.q6_0}"/>
            <Label class="h-a" text="{tr help.metrics.a6_0}"/>
        </Stack>
    </Stack>
    <Button class="h-try" content="{tr help.metrics.try}" command="{binding tryIt}"/>
</Stack>
