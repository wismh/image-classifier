<Stack class="h-topic-body" direction="vertical">
    <Label class="h-kicker" text="{tr help.epochs.kicker}"/>
    <Label class="h-title" text="{tr help.epochs.title}"/>
    <Label class="h-head" text="{tr help.h.idea}"/>
    <Label class="h-p" text="{tr help.epochs.p1}"/>
    <Label class="h-p" text="{tr help.epochs.p2}"/>
    <Stack class="h-note" direction="vertical">
        <Label class="h-note-text" text="{tr help.epochs.note3}"/>
    </Stack>
    <Label class="h-head" text="{tr help.h.faq}"/>
    <Stack class="h-faq" direction="vertical">
        <Stack class="h-qa" direction="vertical">
            <Label class="h-q" text="{tr help.epochs.q5_0}"/>
            <Label class="h-a" text="{tr help.epochs.a5_0}"/>
        </Stack>
    </Stack>
    <Button class="h-try" content="{tr help.epochs.try}" command="{binding tryIt}"/>
</Stack>
